{
  "manifest_version": 3,
  "name": "Alice Bridge",
  "version": "1.0",
  "description": "Bridges Alice desktop app with ChatGPT via native messaging.",

  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "https://chatgpt.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
